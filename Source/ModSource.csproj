<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <WorkshopDir Condition="'$(WorkshopDir)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100</WorkshopDir>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AsAboveSoBelow</AssemblyName>
    <RootNamespace>AsAboveSoBelow</RootNamespace>
    <OutputPath>../1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Publish hygiene: emit only the dll, never a pdb, into the shipped Assemblies folder. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- The DLLs are committed with their source, so embedding the preceding
         checkout's commit would make rebuilding this commit change the DLLs. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldManagedDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldManagedDir)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(WorkshopDir)/2009463077/1.7/Assemblies/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Soft compat references: compile-time only, never shipped, runtime gated on ModsConfig.IsActive. -->
    <Reference Include="BadHygiene">
      <HintPath>$(WorkshopDir)/836308268/1.7/Assemblies/BadHygiene.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0DubCore">
      <HintPath>$(WorkshopDir)/836308268/1.7/Assemblies/0DubCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PipeSystem">
      <HintPath>$(WorkshopDir)/2023507013/1.7/Assemblies/PipeSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rimefeller">
      <HintPath>$(WorkshopDir)/1321849735/1.7/Assemblies/Rimefeller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CombatExtended">
      <HintPath>$(WorkshopDir)/2890901044/Assemblies/CombatExtended.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
