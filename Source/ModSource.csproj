<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <WorkshopDir Condition="'$(WorkshopDir)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100</WorkshopDir>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net472</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <DefineConstants Condition="'$(RimWorldVersion)' == '1.7'">$(DefineConstants);RIMWORLD_17</DefineConstants>
    <AssemblyName>AsAboveSoBelow</AssemblyName>
    <RootNamespace>AsAboveSoBelow</RootNamespace>
    <OutputPath>../$(RimWorldVersion)/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Publish hygiene: emit only the dll, never a pdb, into the shipped Assemblies folder. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- The DLLs are committed with their source, so embedding the preceding
         checkout's commit would make rebuilding this commit change the DLLs. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' != '1.7'">
    <Compile Remove="V2/NativePortals/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Condition="'$(RimWorldVersion)' == '1.6'" Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Condition="'$(RimWorldVersion)' == '1.6'" Include="Lib.Harmony" Version="2.4.1" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Condition="'$(RimWorldVersion)' == '1.6'" Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Condition="'$(RimWorldVersion)' == '1.6'" Include="UnityEngine">
      <HintPath>$(RimWorldManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Condition="'$(RimWorldVersion)' == '1.6'" Include="UnityEngine.InputLegacyModule">
      <HintPath>$(RimWorldManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Condition="'$(RimWorldVersion)' == '1.6'" Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedDir)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Condition="'$(RimWorldVersion)' == '1.6'" Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Condition="'$(RimWorldVersion)' == '1.7'" Include="UnityStubs">
      <HintPath>$(RimWorldManagedDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Condition="'$(RimWorldVersion)' == '1.7'" Include="Waylith">
      <HintPath>$(RimWorldManagedDir)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Condition="'$(RimWorldVersion)' == '1.7'" Include="0Harmony">
      <HintPath>$(WorkshopDir)/2009463077/1.7/Assemblies/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Soft compat references: compile-time only, never shipped, runtime gated on ModsConfig.IsActive. -->
    <Reference Include="BadHygiene">
      <HintPath>$(WorkshopDir)/836308268/$(RimWorldVersion)/Assemblies/BadHygiene.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0DubCore">
      <HintPath>$(WorkshopDir)/836308268/$(RimWorldVersion)/Assemblies/0DubCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PipeSystem">
      <HintPath>$(WorkshopDir)/2023507013/$(RimWorldVersion)/Assemblies/PipeSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rimefeller">
      <HintPath>$(WorkshopDir)/1321849735/$(RimWorldVersion)/Assemblies/Rimefeller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CombatExtended">
      <HintPath>$(WorkshopDir)/2890901044/Assemblies/CombatExtended.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
