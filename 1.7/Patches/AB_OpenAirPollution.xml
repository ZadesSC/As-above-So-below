<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Open air (and every gutter row, which is open air too) is not ground. Left at the
       default it was in PollutionGrid's pollutable-cell count, so the world tile's pollution
       share was diluted by the sky, and pollution could be placed on it.
       ABPollutionCount.ClearPollutionFromInvalidTerrain clears pollution from these
       cells when loading older saves. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/TerrainDef[defName="AB_OpenAir"]</xpath>
    <value>
      <canBePolluted>false</canBePolluted>
    </value>
  </Operation>
</Patch>
