<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Open air (and every gutter row, which is open air too) is not ground. Left at the
       default it was in PollutionGrid's pollutable-cell count, so the world tile's pollution
       share was diluted by the sky, and pollution could be placed on it.
       1.7 only: the 1.7 assembly clears pollution from nonpollutable terrain on load
       (ABPollutionCount.ClearPollutionFromInvalidTerrain). The 1.6 target omits that cleanup, so this
       change would leave old polluted air in the numerator after removing it from the
       denominator. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/TerrainDef[defName="AB_OpenAir"]</xpath>
    <value>
      <canBePolluted>false</canBePolluted>
    </value>
  </Operation>
</Patch>
